# Backend environment configuration example
# Copy this file to backend/.env and replace values before running locally.

ConnectionStrings__DefaultConnection=server=localhost;port=3306;database=task_manager_db;user=root;password=your_password_here
Jwt__Key=super_secret_key_change_me_32_chars_min
Jwt__Issuer=TaskManagerApi
Jwt__Audience=TaskManagerClient
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7
Cors__AllowedOrigins=http://localhost:5176,http://localhost:3000
